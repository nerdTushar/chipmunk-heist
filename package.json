{
  "name": "chipmunk-heist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "assets": "assetpack",
    "assets:watch": "assetpack --watch",
    "dev": "concurrently \"assetpack --watch\" \"vite\"",
    "build": "npm run lint && tsc && assetpack && vite build",
    "lint": "eslint .",
    "cache:clear": "node -e \"import('node:fs').then(fs=>['.assetpack','public/assets'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})))\"",
    "cache:clear:ps": "powershell -Command \"Remove-Item -Recurse -Force .assetpack, public/assets\""
  },
  "dependencies": {
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@eslint/js": "^9.21.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
